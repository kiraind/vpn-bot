            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Куда уходит трафик",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum (rate(vpn_tunnel_transmit_bytes_total[$__rate_interval])) + sum (rate(vpn_tunnel_receive_bytes_total[$__rate_interval]))) * 8",
          "refId": "A",
          "legendFormat": "через REMOTE (заграница)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min((sum (rate(vpn_client_download_bytes_total[$__rate_interval])) + sum (rate(vpn_client_upload_bytes_total[$__rate_interval]))) - (sum (rate(vpn_tunnel_transmit_bytes_total[$__rate_interval])) + sum (rate(vpn_tunnel_receive_bytes_total[$__rate_interval]))), 0) * 8",
          "refId": "B",
          "legendFormat": "напрямую с LOCAL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Приблизительно: туннель до REMOTE считается с накладными расходами шифрования"
    },
